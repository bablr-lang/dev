  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Play",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/play/index.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with hoisting",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/play/hoist.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with fs",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/play/fs.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with blab",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "play.js",
      "cwd": "${workspaceFolder}/repos/blab"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with scratch?",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/play/scratch.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with macrome",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/build.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with btree",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/repos/btree/play.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with agAST helpers",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/repos/agast-helpers/play.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with boot",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/repos/boot/play/index.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with vite plugin",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/repos/vite_plugin-cstml-to-jsx/play.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with spamex-vm",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "trace": true,
      "program": "${workspaceFolder}/repos/spamex-vm/play.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test agAST-vm",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/repos/agast-vm/test/runner.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test language-en-regex",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/repos/language-en-regex-vm-pattern/test/test.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Play with regex-vm",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/repos/regex-vm/play.js"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "CLI with --inspect-brk",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test language-en-cstml",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/repos/language-en-cstml/test/test.js"
    },
    {
      "command": "pnpm exec babel play/fixture.js",
      "name": "Test shorthand.macro",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/repos/boot"
    }
  ]
}
